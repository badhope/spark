# The bundled web UI at src/spark/web/dist/ is INTENTIONALLY TRACKED so that a
# pip install ships a working UI without needing Node. Never add a **/dist/ rule.

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editors
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
*.code-workspace

# Local state of AI coding tools (not part of the product)
.claude/*
!.claude/agents/
.gemini/
.opencode/
.monkeycode/
.aqg/
.workbuddy/
.meituan-catpaw/
.test_workspace/
.spark/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
# 临时 Python 版本对照环境（本地兼容性验证用，不进仓库）
.venv3*/
ENV/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Build output (PyInstaller / setuptools) and release bundles
build/
/dist/
/spark-windows-*.zip
/spark-*-x86_64.tar.gz

# Frontend tooling. Source of truth is web/src; the shipped bundle lives in
# src/spark/web/dist and is tracked.
node_modules/
web/.vite/
web/dist/
*.tsbuildinfo
npm-debug.log*
/package-lock.json

# Logs and scratch output from build/test sessions
*.log
/build-log.txt
/final-test.txt
*.tmp
*.temp
*.bak

# Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Upstream Codex CLI clone kept only as an architecture reference
/codex/

# Enterprise compose runtime data / secrets
/deploy/data/
/deploy/.env
