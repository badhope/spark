{
  "name": "spark-agent",
  "displayName": "Spark Agent",
  "description": "Spark — API-first AI coding agent. Chat, review multi-file diffs and jump to diagnostics without leaving VS Code.",
  "version": "0.15.8",
  "publisher": "badhope",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/badhope/spark"
  },
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "spark.chat.open",
        "title": "Spark: 打开聊天面板",
        "category": "Spark"
      },
      {
        "command": "spark.chat.new",
        "title": "Spark: 新建会话",
        "category": "Spark"
      },
      {
        "command": "spark.chat.askSelection",
        "title": "Spark: 对选中代码提问",
        "category": "Spark"
      },
      {
        "command": "spark.chat.explainSelection",
        "title": "Spark: 解释选中代码",
        "category": "Spark"
      },
      {
        "command": "spark.chat.fixSelection",
        "title": "Spark: 修复选中代码",
        "category": "Spark"
      },
      {
        "command": "spark.openWeb",
        "title": "Spark: 打开 Web UI",
        "category": "Spark"
      },
      {
        "command": "spark.openTui",
        "title": "Spark: 新建 TUI 会话",
        "category": "Spark"
      },
      {
        "command": "spark.diagnostics.open",
        "title": "Spark: 查看 Problems",
        "category": "Spark"
      },
      {
        "command": "spark.askAgent",
        "title": "Spark: Ask about selection",
        "category": "Spark"
      },
      {
        "command": "spark.inline.edit",
        "title": "Spark: 内联编辑选中代码",
        "category": "Spark"
      },
      {
        "command": "spark.inline.toggle",
        "title": "Spark: 开关 NES 内联建议",
        "category": "Spark"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "spark.chat.askSelection",
          "when": "editorHasSelection",
          "group": "navigation@20"
        },
        {
          "command": "spark.chat.fixSelection",
          "when": "editorHasSelection",
          "group": "navigation@21"
        },
        {
          "command": "spark.inline.edit",
          "when": "editorHasSelection",
          "group": "navigation@22"
        }
      ]
    },
    "keybindings": [
      {
        "command": "spark.chat.askSelection",
        "key": "ctrl+alt+shift+s",
        "mac": "cmd+alt+shift+s",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Spark",
      "properties": {
        "spark.executable": {
          "type": "string",
          "default": "spark",
          "description": "spark 可执行文件路径（打包版 EXE，或 pip install spark-agent 后的 spark）。"
        },
        "spark.approval": {
          "type": "string",
          "enum": [
            "suggest",
            "auto-edit",
            "full-auto",
            "plan-only",
            "approve-plan",
            "manual"
          ],
          "default": "suggest",
          "description": "从 VS Code 启动的会话审批档位。"
        },
        "spark.serverUrl": {
          "type": "string",
          "default": "",
          "description": "复用已在运行的 Spark Web 地址（例如 http://127.0.0.1:8000）；留空则由扩展自动拉起。"
        },
        "spark.token": {
          "type": "string",
          "default": "",
          "description": "连接非回环 Spark Web 时的控制令牌（X-Spark-Token）。仅保存在本机设置。"
        },
        "spark.autoOpenDiff": {
          "type": "boolean",
          "default": true,
          "description": "审批请求带 diff 时自动打开内联 diff 预览。"
        },
        "spark.inlineCompletions.enabled": {
          "type": "boolean",
          "default": false,
          "description": "开启编辑器内 NES 内联建议。默认关闭：每次触发都会调用一次模型，按需开启。"
        },
        "spark.inlineCompletions.mode": {
          "type": "string",
          "enum": [
            "nes",
            "edit"
          ],
          "default": "nes",
          "description": "内联建议模式；nes = 光标处下一步编辑，edit = 以选中文本为上下文。"
        },
        "spark.inlineCompletions.debounceMs": {
          "type": "number",
          "default": 450,
          "minimum": 0,
          "maximum": 5000,
          "description": "内联建议防抖毫秒数。"
        },
        "spark.inlineCompletions.maxContextChars": {
          "type": "number",
          "default": 3000,
          "minimum": 500,
          "maximum": 12000,
          "description": "光标前后各取多少字符作为上下文。"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package"
  }
}
